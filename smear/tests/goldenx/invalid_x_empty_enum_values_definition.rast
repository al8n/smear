Root@0..11
  Document@0..11
    EnumTypeDefinition@0..10
      Name@0..4 "enum"
      Space@4..5 " "
      DefinitionName@5..7
        Name@5..6 "E"
        Space@6..7 " "
      EnumValuesDefinition@7..10
        LBrace@7..8 "{"
        Space@8..9 " "
        RBrace@9..10 "}"
    Newline@10..11 "\n"
