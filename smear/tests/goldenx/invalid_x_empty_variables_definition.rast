Root@0..16
  Document@0..16
    OperationDefinition@0..15
      Name@0..5 "query"
      Space@5..6 " "
      DefinitionName@6..7
        Name@6..7 "Q"
      VariablesDefinition@7..9
        LParen@7..8 "("
        RParen@8..9 ")"
      Space@9..10 " "
      SelectionSet@10..15
        LBrace@10..11 "{"
        Space@11..12 " "
        Field@12..14
          Name@12..13 "f"
          Space@13..14 " "
        RBrace@14..15 "}"
    Newline@15..16 "\n"
