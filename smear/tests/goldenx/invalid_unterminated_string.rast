Root@0..26
  Document@0..26
    OperationDefinition@0..25
      SelectionSet@0..25
        LBrace@0..1 "{"
        Newline@1..2 "\n"
        Space@2..3 " "
        Space@3..4 " "
        Field@4..24
          Name@4..5 "f"
          Arguments@5..24
            LParen@5..6 "("
            Argument@6..24
              Name@6..7 "a"
              Colon@7..8 ":"
              Space@8..9 " "
              Gap@9..23 "\"unterminated)"
