"Fat arrow operator in map values"

input Config {
  routes: HashMap<String!, String!> = map!{
    "/home" => "HomePage"
    "/about" => "AboutPage"
    "/contact" => "ContactPage"
  }

  handlers: HashMap<String!, HashMap<Int!, String!>!>! = map!{
    "error" => map!{
      404 => "NotFoundHandler"
      500 => "ServerErrorHandler"
    }
  }
}
